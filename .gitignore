# Python
__pycache__/
*.pyc
.venv/
venv/

# 生成物（重跑即可再生，且含课程内容，不入库）
out/
CS340/06_笔记/*.html
CS340/01_讲义/*.pdf
!CS340/06_笔记/.gitkeep
!CS340/01_讲义/.gitkeep

# 密钥（2026-11-16）：任何 key 都不进 Git
.env
.env.*
*.key
*.pem
api.json
secrets/

# 系统噪声
Thumbs.db
desktop.ini
~$*
.DS_Store
*.log

# 本地用量日志（2026-11-16）
_logs/

# 打包产物（2026-11-17）：exe 体积大且可重建，不入库；只入库 tools\build 里的 spec 与脚本
dist/
.build/
*.spec.bak


# 交接卡是本机状态（PID / 本地路径 / 端口），不进公开库
_交接-*.md


# 真实课程数据不进公开库（2026-11-17 用户定 A 方案）：只保留示例课程 DEMO/
CS340/_lessons/*.py


# 2026-11-17：用户导入的原件（真实课件，绝不入库）
*/00_原件/*
!*/00_原件/.gitkeep

# 删除回收站（2026-11-17）：删掉的东西只是从这里取回，不进 Git
_trash/

# 课件页图（2026-11-21）：导入时从原件导出的 gen/，可重跑再生成，且是真实课程内容
*/06_笔记/assets/gen/

# 2026-11-21：真实课程数据一律不进公开库（只保留示例课程 DEMO）
#   这条原来只写了 CS340/_lessons/*.py，结果新建的 生物学 / 人体解剖生理学 连同仓根的
#   原件 PDF 一起被提交进了仓库（本地未推，已撤回）。改成通配，DEMO 例外。
*/_lessons/*.py
!DEMO/_lessons/*.py
/*.pdf
