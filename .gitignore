# Python
__pycache__/
*.pyc
.venv/
venv/

# 生成物（重跑即可再生，且含课程内容，不入库）
out/
CS340/06_笔记/*.html
CS340/01_讲义/*.pdf
!CS340/06_笔记/.gitkeep
!CS340/01_讲义/.gitkeep

# 密钥（2026-11-16）：任何 key 都不进 Git
.env
.env.*
*.key
*.pem
api.json
secrets/

# 系统噪声
Thumbs.db
desktop.ini
~$*
.DS_Store
*.log

# 本地用量日志（2026-11-16）
_logs/

# 打包产物（2026-11-17）：exe 体积大且可重建，不入库；只入库 tools\build 里的 spec 与脚本
dist/
.build/
*.spec.bak


# 交接卡是本机状态（PID / 本地路径 / 端口），不进公开库
_交接-*.md


# 真实课程数据不进公开库（2026-11-17 用户定 A 方案）：只保留示例课程 DEMO/
CS340/_lessons/*.py


# 2026-11-17：用户导入的原件（真实课件，绝不入库）
*/00_原件/*
!*/00_原件/.gitkeep
